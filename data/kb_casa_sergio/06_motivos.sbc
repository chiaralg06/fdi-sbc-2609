# Motivos: lo que pasa en la casa, las normas de los padres y los avisos.
# Cada uno con su categoría (05_modos_y_autoridad.sbc) y su nombre en
# castellano, para poder explicar cada decisión.

# ---------- Seguridad ----------
menor_sin_adulto categoria seguridad, menor_sin_adulto nombre "Pablo está en la piscina sin un adulto".
peligro_cuchillas categoria seguridad, peligro_cuchillas nombre "Hay alguien en el jardín y el cortacésped es peligroso".
cierre_nocturno categoria seguridad, cierre_nocturno nombre "De noche la casa se cierra".

# ---------- Thor ----------
perro_solo categoria perro, perro_solo nombre "Thor está solo junto a la piscina".
perro_puede_escaparse categoria perro, perro_puede_escaparse nombre "Thor está junto a una puerta de la calle".
perro_con_calor categoria perro, perro_con_calor nombre "Thor está fuera con mucho calor".

# ---------- Salud ----------
calor_extremo categoria salud, calor_extremo nombre "Ola de calor: hay que refrescar donde haya gente".

# ---------- Vecinos ----------
descanso_vecinos categoria vecinos, descanso_vecinos nombre "Es de madrugada: no se pone música fuera".

# ---------- Normas de los padres ----------
# Cuentan como algo que piden los padres. Solo rigen en modo normal.
norma_pantallas categoria padres, norma_pantallas autor elena, norma_pantallas nombre "Norma de Elena: entre semana, Pablo no usa pantallas por la noche".
norma_piscina categoria padres, norma_piscina autor luis, norma_piscina nombre "Norma de Luis: en invierno la piscina no se climatiza".
norma_salidas categoria padres, norma_salidas autor luis, norma_salidas nombre "Norma de Luis: Pablo no sale de casa de noche".
# Al poner el modo vacaciones, los padres deciden que todo lo que gasta se
# apaga: por eso también es de categoría padres.
casa_vacia categoria padres, casa_vacia nombre "La casa está vacía por vacaciones".

# ---------- Ahorro ----------
tarifa_punta categoria ahorro, tarifa_punta nombre "La luz está en tarifa punta".
carga_valle categoria ahorro, carga_valle nombre "Se carga el coche con la luz más barata".
llueve categoria ahorro, llueve nombre "Está lloviendo: no hace falta regar".

# ---------- Confort ----------
frio categoria confort, frio nombre "Hace frío donde hay alguien".
calor categoria confort, calor nombre "Hace calor donde hay alguien".
humedad categoria confort, humedad nombre "Hay humedad en el sótano".
oscuro_con_gente categoria confort, oscuro_con_gente nombre "Es de noche y hay gente fuera".
llegada_coche categoria confort, llegada_coche nombre "Llega un coche de la familia".
no_mojar categoria confort, no_mojar nombre "Hay gente en el jardín: no se riega".

# ---------- Mantenimiento ----------
riego_programado categoria mantenimiento, riego_programado nombre "Riego programado".
corte_programado categoria mantenimiento, corte_programado nombre "Corte del césped programado".
filtrado_diario categoria mantenimiento, filtrado_diario nombre "Filtrado diario de la piscina".

# ---------- Avisos (no chocan con nada) ----------
aviso_menor_piscina es_un aviso, aviso_menor_piscina nombre "Pablo está solo en la piscina".
aviso_perro es_un aviso, aviso_perro nombre "Thor necesita que alguien vaya".
llegada_tarde es_un aviso, llegada_tarde nombre "Un hijo llega de noche a casa".
intento_salida es_un aviso, intento_salida nombre "Pablo ha intentado salir de noche".
peticion_modo es_un aviso, peticion_modo nombre "Un hijo pide cambiar el modo de la casa".
empate_padres es_un aviso, empate_padres nombre "Luis y Elena piden cosas contrarias".
ventana_abierta es_un aviso, ventana_abierta nombre "Hay una ventana abierta con el clima encendido".
