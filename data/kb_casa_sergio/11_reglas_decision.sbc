# Cómo decide la casa: permisos, peticiones, modo y conflictos.

# ---------- Quién puede usar qué desde la app ----------
# Lo de las zonas comunes, cualquiera. Lo de un dormitorio, su dueño. Lo del
# cuarto de un menor, también sus padres.
P puede_usar D <- P tipo habitante, D esta_en E, E uso comun.
P puede_usar D <- D esta_en E, E dormitorio_de P.
P puede_usar D <- P tipo habitante, P categoria padres, D esta_en E, E dormitorio_de H, H tipo menor.

# ---------- Peticiones desde la app ----------
# El motivo de una petición es la propia persona.
D encender_por P <- P pide_encender D, P puede_usar D.
D apagar_por P <- P pide_apagar D, P puede_usar D.
D abrir_por P <- P pide_abrir D, P puede_usar D.
D cerrar_por P <- P pide_cerrar D, P puede_usar D.

# ---------- Modo de la casa ----------
# Solo los padres lo cambian. Si lo pide un hijo, se avisa a los padres.
chalet modo M <- P activa_modo M, P categoria padres, P tipo habitante.
A notificar_por peticion_modo <- P activa_modo M, P categoria hijo_mayor, A categoria padres, A tipo habitante.
A notificar_por peticion_modo <- P activa_modo M, P categoria hijo_menor, A categoria padres, A tipo habitante.

# ---------- Orden de importancia ----------
C1 mas_importante_que C2 <- C1 antes_que C2.
C1 mas_importante_que C3 <- C1 antes_que C2, C2 mas_importante_que C3.

# ---------- Acciones y conflictos ----------
# Qué se quiere hacer con cada aparato (sin el motivo)
D accion A <- V verbo A, D V M.

# Hay conflicto si dos motivos piden cosas contrarias sobre el mismo aparato
D conflicto M1 <- V1 contrario V2, D V1 M1, D V2 M2.

# Gana el motivo de categoría más importante, y se apunta cuál pierde
D gana M1, D pierde M2 <- V1 contrario V2, D V1 M1, M1 categoria C1, D V2 M2, M2 categoria C2, C1 mas_importante_que C2.

# Lo que se hace al final es la acción del motivo que gana
D hace A <- D gana M, V verbo A, D V M.

# Si chocan dos motivos de la misma categoría (por ejemplo, Luis y Elena),
# no gana ninguno: hay empate. Si son los padres, se les avisa.
D empate si <- V1 contrario V2, D V1 M1, M1 categoria C, D V2 M2, M2 categoria C.
P notificar_por empate_padres <- V1 contrario V2, D V1 M1, M1 categoria padres, D V2 M2, M2 categoria padres, P categoria padres, P tipo habitante.

# Comprobación: dos resultados contrarios sobre lo mismo (no debería pasar)
D contradiccion si <- D hace A1, D hace A2, A1 opuesta A2.
