# Reglas del horario: de la hora del escenario a todo lo que depende de ella.
#
# El escenario dice "colegio hora h0030". De ahí sale la franja (madrugada), y
# de la franja: si hay silencio, si se corta el aire, si las visitas pueden
# subir, qué espacios están abiertos o cerrados y quién está de turno.

colegio franja F <- colegio hora H, H franja F.
colegio periodo P <- colegio franja F, F periodo P.

# Lo que la franja dice con "si" o "no" pasa a ser el estado del colegio.
# Una sola regla por propiedad: la variable V copia el "si" o el "no".
colegio silencio V <- colegio franja F, F silencio V.
colegio corte_aire V <- colegio franja F, F corte_aire V.
colegio visitas_a_habitacion V <- colegio franja F, F horario_visitas V.

# ---------- Qué está abierto ----------
E abierto si <- E horario continuo.
E abierto si <- E abre_en F, colegio franja F.
E cerrado si <- E cierra_en F, colegio franja F.

# ---------- Personal de turno ----------
R de_turno si <- R turno T, colegio franja F, F en_turno T.

# ---------- Rutinas de cada colegial ----------
P despierta si <- P despertador H, colegio hora H.
P se_va_a_dormir si <- P se_acuesta H, colegio hora H.
