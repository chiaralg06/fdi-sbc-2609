futbolin es_un equipamiento_ocio, futbolin esta_en sala_juegos.
mesa_ping_pong es_un equipamiento_ocio, mesa_ping_pong esta_en sala_juegos.

tv_1 es_un television, tv_1 esta_en sala_tv, tv_1 nombre "Televisión 1".
tv_2 es_un television, tv_2 esta_en sala_tv, tv_2 nombre "Televisión 2".

# ---------- Lavandería: se paga con el móvil y arranca sola ----------
lavadora_1 es_un lavadora, lavadora_1 esta_en lavanderia, lavadora_1 nombre "Lavadora 1".
lavadora_2 es_un lavadora, lavadora_2 esta_en lavanderia, lavadora_2 nombre "Lavadora 2".
secadora_1 es_un secadora, secadora_1 esta_en lavanderia, secadora_1 nombre "Secadora 1".
