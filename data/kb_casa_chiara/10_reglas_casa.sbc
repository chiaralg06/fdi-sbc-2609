# Reglas generales de la casa: conexiones, ubicación y tipos.

# Una puerta comunica en los dos sentidos. Uso acceso_a para que la regla
# no se llame a sí misma (con razona si! entraría en bucle).
X conecta_con Y <- X acceso_a Y.
X conecta_con Y <- Y acceso_a X.

# En qué estancia está cada cosa aunque esté dentro de un mueble. Termina
# porque esta_en no tiene ciclos. Pongo parte_de casa en vez de
# E tipo estancia porque es mucho más rápido y esta regla se usa todo el rato.
X en_estancia E <- X esta_en E, E parte_de casa.
X en_estancia E <- X esta_en M, M en_estancia E.

# C hereda_de D: subclase directa o indirecta
C hereda_de D <- C subclase_de D.
C hereda_de E <- C subclase_de D, D hereda_de E.

# X tipo C: X es de C o de alguna subclase. La recursión baja desde la clase
# (sus subclases) en vez de subir desde X; así para buscar las luces no se
# recorren todos los objetos de la casa. Con razona si! se nota muchísimo.
X tipo C <- X es_un C.
X tipo C <- D subclase_de C, X tipo D.
