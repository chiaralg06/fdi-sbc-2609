armario_3 es_un mueble, armario_3 esta_en dormitorio_3.
mesillas_3 es_un mueble, mesillas_3 esta_en dormitorio_3.
escritorio_3 es_un mueble, escritorio_3 esta_en dormitorio_3.

# ---------- Muebles Terraza 1----------
sofas_terraza es_un mueble, sofas_terraza esta_en terraza_1.
mesa_terraza es_un mueble, mesa_terraza esta_en terraza_1.
tendedero es_un mueble, tendedero esta_en terraza_1.

# ---------- Muebles Terraza 2----------
armarios_ropa es_un mueble, armarios_ropa esta_en terraza_2.

# ---------- Electrodomésticos ----------
nevera es_un electrodomestico, nevera esta_en cocina.
kettle es_un electrodomestico, kettle esta_en cocina.
vitroceramica es_un electrodomestico, vitroceramica esta_en cocina.
