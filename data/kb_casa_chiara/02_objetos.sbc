contador_gas es_un electrodomestico, contador_gas esta_en terraza_2.

# ---------- Electrónica ----------
# La tele es una smart TV: además de aparato electrónico, se puede controlar
# (ver 01_clases.sbc), así que la Alexa la controla.
television es_un smart_tv, television esta_en salon, television nombre "Televisión".
router es_un aparato_electronico, router esta_en salon.
movistar es_un aparato_electronico, movistar esta_en salon.
