# Reglas generales de la domótica. El estado del momento lo pone cada
# escenario (casa estacion invierno, padre estado dormido, sensor_lluvia
# detecta lluvia...) y aquí se convierte en situaciones. Lo que se hace en
# cada una está en 13, 14 y 15.

# Cada asistente controla lo de su estancia. Si pongo otro enchufe en el
# salón, la Alexa ya lo controla sin tocar nada.
A controla D <- A tipo asistente_voz, A en_estancia E, D tipo controlable, D en_estancia E.
# y lo que está enchufado a algo que controla (el deco)
A controla X <- X enchufada_a S, A controla S.

# Cada persona habla con el asistente de donde está. En la cocina no hay,
# así que desde allí las órdenes no llegan. P tipo persona es para que Miko
# no cuente.
P habla_con A <- P ubicacion E, A tipo asistente_voz, A en_estancia E, P tipo persona.

# El modo puede venir del escenario o de una orden a la Alexa
casa modo noche <- P ordena buenas_noches.
casa modo fuera <- P ordena me_voy.

# Ausente vale para fuera y para vacaciones, así no repito las reglas de
# ahorro, cierre y Miko para cada modo.
casa ausente si <- casa modo fuera.
casa ausente si <- casa modo vacaciones.

# Situaciones a partir de los sensores. Compruebo el tipo de sensor para que
# por ejemplo el termómetro no pueda "detectar" humo.
casa situacion lluvia <- S detecta lluvia, S tipo sensor_lluvia.
casa situacion calor <- S detecta calor, S tipo sensor_temperatura.
E situacion humo <- S detecta humo, S tipo sensor_humo, S en_estancia E.
E situacion fuga_gas <- S detecta gas, S tipo sensor_gas, S en_estancia E.
E situacion humedad_alta <- S detecta humedad_alta, S tipo sensor_humedad, S en_estancia E.
E situacion fuga_agua <- S detecta agua, S tipo sensor_inundacion, S en_estancia E.

# Abrir la puerta solo es raro si no hay nadie. Y depende de cómo: con
# código es una visita (la cuidadora de Miko), sin código es una intrusión.
casa situacion intrusion <- casa ausente si, S detecta apertura, S tipo sensor_apertura, C detecta sin_codigo, C tipo cerradura_inteligente.
casa situacion visita <- casa ausente si, C identifica P, C tipo cerradura_inteligente, P tiene_acceso si.

# el movimiento en el pasillo solo importa de noche
E situacion paso_nocturno <- casa modo noche, S detecta movimiento, S tipo sensor_movimiento, S en_estancia E.

casa situacion mascota_sola <- casa ausente si, M tipo mascota, M ubicacion E, E parte_de casa.

# M origen X: el sensor, persona o aparato que ha provocado el motivo M.
# Con esto se puede explicar una acción entera, por ejemplo:
#   luz_salon encender_por humo, humo origen sensor_humo_cocina
M origen S <- L indica M, S detecta L.
O origen P <- P ordena O.
visita origen P <- casa situacion visita, C identifica P.
tender_dentro origen D <- casa situacion lluvia, D detecta fin_ciclo, D lava ropa.
sobrecarga origen X <- casa situacion sobrecarga, X activo si.
descanso origen X <- casa modo noche, X estado dormido.
mascota_sola origen M <- casa situacion mascota_sola, M tipo mascota, M ubicacion E, E parte_de casa.
mascota_en_casa origen M <- M tipo mascota, M ubicacion E, E parte_de casa.

# Acciones y conflictos
D accion A <- V verbo A, D V M.

# conflicto: dos motivos piden acciones opuestas sobre lo mismo
D conflicto M1 <- V1 opuesto V2, D V1 M1, D V2 M2.

# gana el motivo de categoría más alta, y su acción es la decisión
D se_impone M1 <- V1 opuesto V2, D V1 M1, D V2 M2, M1 categoria C1, M2 categoria C2, C1 prevalece_sobre C2.
D gana_con V1 <- V1 opuesto V2, D V1 M1, D V2 M2, M1 categoria C1, M2 categoria C2, C1 prevalece_sobre C2.
D decision A <- D gana_con V, V verbo A.

# Problema: si chocan tres motivos de tres categorías (Miko solo en casa y
# humo: la calefacción se enciende por Miko y se apaga por ahorro y por humo)
# cada pareja se resuelve por separado y salen dos decisiones. Para quedarme
# solo con la más fuerte haría falta negación. Esta regla al menos lo
# detecta; en ese caso vale la de categoría más alta.
D decision_dudosa si <- D gana_con V1, V1 opuesto V2, D gana_con V2.

# orden completo a partir de por_encima_de (categorías y electrodomésticos)
C1 prevalece_sobre C2 <- C1 por_encima_de C2.
C1 prevalece_sobre C3 <- C1 por_encima_de C2, C2 prevalece_sobre C3.
