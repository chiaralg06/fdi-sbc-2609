# Jerarquía de clases. Cada cosa solo dice su clase más concreta con es_un
# y "tipo" saca el resto. No hay ciclos, así que con razona si! termina.

# Estancias
dormitorio subclase_de estancia.
zona_comun subclase_de estancia.
cuarto_humedo subclase_de estancia.
exterior subclase_de estancia.

# Objetos
mueble subclase_de objeto.
electrodomestico subclase_de objeto.
aparato_electronico subclase_de objeto.

# Habitantes
persona subclase_de habitante.
mascota subclase_de habitante.
gato subclase_de mascota.

# Domótica: asistentes de voz, sensores y cosas que se pueden controlar
dispositivo_inteligente subclase_de objeto.
asistente_voz subclase_de dispositivo_inteligente.
sensor subclase_de dispositivo_inteligente.
controlable subclase_de dispositivo_inteligente.

luz_inteligente subclase_de controlable.
persiana_motorizada subclase_de controlable.
toldo_motorizado subclase_de controlable.
enchufe_inteligente subclase_de controlable.
extractor subclase_de controlable.
robot_aspirador subclase_de controlable.
smart_tv subclase_de controlable, smart_tv subclase_de aparato_electronico.
camara subclase_de controlable.
cerradura_inteligente subclase_de controlable.
ventana_motorizada subclase_de controlable.
valvula subclase_de controlable.
valvula_gas subclase_de valvula.
valvula_agua subclase_de valvula.
riego_automatico subclase_de controlable.

# Los que tienen wifi siguen siendo electrodomésticos, pero se pueden apagar
electrodomestico_inteligente subclase_de electrodomestico.
electrodomestico_inteligente subclase_de controlable.

# Cosas de Miko
dispositivo_mascota subclase_de controlable.
comedero_automatico subclase_de dispositivo_mascota.
arenero_automatico subclase_de dispositivo_mascota.

aparato_clima subclase_de controlable.
aire_acondicionado subclase_de aparato_clima.
calefaccion_central subclase_de aparato_clima.

sensor_movimiento subclase_de sensor.
sensor_apertura subclase_de sensor.
sensor_humo subclase_de sensor.
sensor_humedad subclase_de sensor.
sensor_lluvia subclase_de sensor.
sensor_temperatura subclase_de sensor.
sensor_gas subclase_de sensor.
sensor_inundacion subclase_de sensor.
# el cubo solo avisa de si está lleno, por eso lo pongo como sensor
cubo_inteligente subclase_de sensor.

# Lo que puede hacer chispa y no se toca si hay fuga de gas. Va por clase,
# así un dispositivo nuevo de estas clases entra solo.
luz_inteligente riesgo_chispa si.
enchufe_inteligente riesgo_chispa si.
extractor riesgo_chispa si.
aparato_clima riesgo_chispa si.
robot_aspirador riesgo_chispa si.
smart_tv riesgo_chispa si.
electrodomestico_inteligente riesgo_chispa si.
