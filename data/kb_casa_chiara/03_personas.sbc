# La familia y Miko. Dónde está cada uno en cada momento (ubicacion) lo
# pone cada escenario, aquí no.

yo es_un persona, yo nombre "Yo", yo vive_en casa.
madre es_un persona, madre nombre "Mamá", madre vive_en casa.
padre es_un persona, padre nombre "Papá", padre vive_en casa.

miko es_un gato, miko nombre "Miko", miko pertenece_a yo.

# Familia (progenitor_de e hijo_de salen de 11_reglas_familia)
madre madre_de yo.
padre padre_de yo.

# Lo pongo en los dos sentidos porque una regla simétrica entra en bucle
# con razona si!
madre conyuge_de padre, padre conyuge_de madre.

# Dónde duerme cada uno
madre duerme_en dormitorio_1.
padre duerme_en dormitorio_1.
yo duerme_en dormitorio_2.
miko duerme_en sofa.

# Tareas. Qué aparato va con cada tarea está en 04_domotica (tarea_asociada)
yo tarea sacar_basura.
yo tarea poner_lavavajillas.
yo tarea dar_de_comer_al_gato.
madre tarea hacer_compra.
padre tarea poner_lavadora.
padre tarea vaciar_arenero.
