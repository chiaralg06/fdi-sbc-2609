# Escenario 5: amanece. La casa sigue en modo noche, mi padre duerme y mi
# madre y yo nos despertamos. Miko pide el desayuno.
# uv run -m sbc data/kb_casa_chiara data/kb_casa_chiara/escenarios/5_amanecer.sbq

razona si!

casa modo noche.
padre estado dormido.
madre ubicacion dormitorio_1.
yo ubicacion dormitorio_2.
miko ubicacion salon.

# Solo se baja la persiana donde alguien sigue dormido
D bajar_por descanso?

# ¿Con qué asistente habla cada uno?
P habla_con A?

# ---------- "Alexa, buenos días" desde mi habitación ----------
yo ordena buenos_dias.

persiana_dormitorio_2 accion A?
persiana_dormitorio_2 conflicto M?
# La orden solo llega al Echo de mi habitación
persiana_salon subir_por M?

# ---------- "Alexa, buenos días" desde el dormitorio de mis padres ----------
# Mi padre sigue dormido: la persiana no sube
madre ordena buenos_dias.

persiana_dormitorio_1 conflicto M?
persiana_dormitorio_1 se_impone M, M nombre N?
persiana_dormitorio_1 decision A?

# ---------- Desayuno de Miko ----------
casa hora desayuno.

comedero_miko dispensar_por M, M nombre N?

comedero_miko detecta vacio.
P notificar_por comedero_vacio?

# ---------- El arenero ----------
# Miko lo ha usado, pero sigue siendo modo noche: no se limpia
arenero_miko detecta uso.
arenero_miko decision A?

# Y además Miko está dentro
arenero_miko detecta mascota_dentro.
arenero_miko detener_por M, M nombre N?

arenero_miko detecta lleno.
P notificar_por M, M nombre N?

# Ningún dispositivo con decisiones contradictorias
D decision_dudosa si?
