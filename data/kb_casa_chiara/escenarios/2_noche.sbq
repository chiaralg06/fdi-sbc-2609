# Escenario 2: noche entre semana, todos duermen.
# Miko usa el arenero, alguien se levanta, luego llega una invitada y por
# último salta el detector de humo de la cocina.

razona si!

casa modo noche.
madre estado dormido, padre estado dormido, yo estado dormido.
miko ubicacion salon.

# Modo noche
D bajar_por descanso?
D apagar_por descanso?
alexa silenciar_por M?
cerradura cerrar_por M?

# La habitación de invitados está vacía: su persiana no se toca
persiana_dormitorio_3 bajar_por M?

# el robot no sale porque Miko está en casa (y nadie pide encenderlo)
aspiradora accion A?
aspiradora conflicto M?

# Miko usa el arenero
# de noche no se limpia porque hace ruido
arenero_miko detecta uso.

arenero_miko conflicto M?
arenero_miko decision A?

# Alguien se levanta
sensor_mov_pasillo detecta movimiento.

pasillo situacion paso_nocturno?
luz_pasillo conflicto M?
luz_pasillo decision A?
# La luz del salón no se enciende: el sensor está en el pasillo
luz_salon encender_por M?

# Llega una invitada
invitada es_un persona, invitada nombre "Invitada", invitada duerme_en dormitorio_3.
invitada estado dormido.

persiana_dormitorio_3 bajar_por M?

# Salta el detector de humo de la cocina
sensor_humo_cocina detecta humo.

E situacion humo, E nombre N?
D conflicto M?
D se_impone M?
D decision A, D nombre N?
alexa avisar_por M, M nombre N?
P notificar_por humo?

# por qué se abre la puerta de madrugada
cerradura decision A, cerradura se_impone M, M nombre NM, M origen S, S nombre NS?
# y qué motivo ha perdido
cerradura conflicto M, M origen X?
D decision_dudosa si?
