# Escenario 3: tarde de verano. Hace calor, estoy en el salón y hay ropa
# tendida. Luego llega una tormenta, alguien se ducha en el baño grande y se
# ponen la lavadora y el lavavajillas.
# uv run -m sbc data/kb_casa_chiara data/kb_casa_chiara/escenarios/3_tormenta_verano.sbq

razona si!

casa estacion verano.
yo ubicacion salon.
miko ubicacion dormitorio_2.
tendedero tiene ropa.
sensor_temp_exterior detecta calor.

# Con calor: toldo fuera y aire del salón, porque estoy ahí
D accion A?
D encender_por calor, D nombre N?

# ---------- Llega la tormenta ----------
sensor_lluvia detecta lluvia.

casa situacion S?
toldo conflicto M?
toldo decision A?
D cerrar_por lluvia?
alexa avisar_por M, M nombre N?

# ---------- Alguien se ducha ----------
sensor_humedad_baño detecta humedad_alta.

D encender_por humedad?

# ---------- Lavadora y lavavajillas ----------
# Con el aire encendido por el calor, son tres aparatos de alto consumo
lavadora estado encendido.
casa situacion sobrecarga?
lavavajillas estado encendido.
casa situacion sobrecarga?
D apagar_por sobrecarga?

# Todo lo que hace la casa ahora
D accion A?
