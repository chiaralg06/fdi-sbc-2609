# Consultas sobre la casa, sin ninguna situación especial
# uv run -m sbc data/kb_casa_chiara data/kb_casa_chiara/consultas.sbq

# ========== Sin razonar: solo lo escrito ==========

# ¿Qué hay directamente en el salón?
X esta_en salon?

# ¿Qué hay en la terraza grande?
X esta_en terraza_1?

# ¿Qué electrodomésticos hay y en qué estancia?
X es_un electrodomestico, X esta_en H, H nombre N?

# ¿Quién duerme dónde?
P duerme_en H, P nombre NP, H nombre NH?

# ¿Qué sabemos de Miko? (variable en el predicado)
miko R X?

# ¿Qué tareas hace cada uno?
P tarea T, P nombre N?

# Sí/no
nevera esta_en salon?
yo hijo_de madre?

# Lo deducido todavía no existe
X conecta_con salon?
alexa controla D?

# ========== Razonando ==========
razona si!

# Conexiones en los dos sentidos, escritas una sola vez
X conecta_con salon?
X conecta_con pasillo, X tipo dormitorio?
baño_2 conecta_con X, X conecta_con Y?

# En qué estancia está cada cosa, aunque esté en un mueble
X en_estancia dormitorio_2?
portatil en_estancia E?
llaves en_estancia E, E nombre N?
X tipo mueble, X en_estancia E, E tipo exterior?

# Tipos heredados
miko tipo C?
television tipo C?
X tipo dormitorio, P duerme_en X, P nombre N?
X tipo habitante, X nombre N?
X tipo sensor, X en_estancia E?
X tipo cuarto_humedo, D tipo controlable, D en_estancia X?

# Familia
yo hijo_de P, P nombre N?

# ¿Qué controla la Alexa? (el deco de Movistar, a través de su enchufe)
alexa controla D?
alexa controla movistar?
alexa controla luz_pasillo?

# Cada asistente controla lo de su habitación
A tipo asistente_voz, A controla D, D tipo persiana_motorizada?

# Dispositivos de Miko y dónde están
D tipo dispositivo_mascota, D sirve_a miko, D en_estancia E?

# Qué no se puede tocar si hay una fuga de gas
K riesgo_chispa si, D tipo K, D en_estancia cocina?

# Qué electrodomésticos importan más que la lavadora
X prevalece_sobre lavadora, X consumo alto?

# Orden de prioridades
seguridad prevalece_sobre C?
C prevalece_sobre ahorro?
confort prevalece_sobre descanso?

# Sin ninguna situación, la casa no hace nada
D accion A?

razona no!

# Sin razonar, otra vez nada deducido
X conecta_con salon?
