# Sin razonar, las reglas no deducen nada
X progenitor_de luis?

descubre!

# Alternativas
X progenitor_de luis?
X progenitor_de ana?

# Varios consecuentes
X abuelo_de nora?
nora nieto_de X?
X abuelo_de Y, X padre_de ana?

# Recursiva
X antepasado_de nora?
pepe antepasado_de X?
nora antepasado_de X?

# Un hecho nuevo no se razona hasta el siguiente descubre!
nora madre_de lia.
X antepasado_de lia?
descubre!
X antepasado_de lia?

# Ni una regla nueva
X bisabuelo_de Y <- X progenitor_de Z, Z abuelo_de Y.
X bisabuelo_de Y?
descubre!
X bisabuelo_de Y?
